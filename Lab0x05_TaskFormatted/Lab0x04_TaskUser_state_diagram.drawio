              <mxPoint x="290" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="exitnumeric" edge="1" parent="1" source="numeric" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" target="exit" value="e / E">
          <mxGeometry relative="1" as="geometry">
