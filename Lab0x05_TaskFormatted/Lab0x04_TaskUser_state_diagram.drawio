<mxfile host="app.diagrams.net">
  <diagram id="taskuser-states" name="TaskUser state transitions">
    <mxGraphModel dx="3304" dy="1103" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;text;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;" value="TaskUser" vertex="1">
          <mxGeometry height="55" width="650" x="460" y="95" as="geometry" />
        </mxCell>
        <mxCell id="initial" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" value="Start" vertex="1">
          <mxGeometry height="65" width="180" x="200" y="90" as="geometry" />
        </mxCell>
        <mxCell id="command" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="Wait for command&#xa;h/H: help menu&#xa;l/L or r/R: request left or right motor&#xa;p/P: requests a gain value&#xa;e/E: exits proimpt and stops both motors&#xa;Use selected velocity and Kp; reject if busy" vertex="1">
          <mxGeometry height="180" width="440" x="70" y="270" as="geometry" />
        </mxCell>
        <mxCell id="numeric" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="Reads the velocity or Kp&#xa;Collect digits, initial minus, and one period&#xa;Correct the characters and do not accept if invalid &#xa;Enter accepts -1000rad/s to +1000rad/s velocity" vertex="1">
          <mxGeometry height="180" width="440" x="690" y="270" as="geometry" />
        </mxCell>
        <mxCell id="exit" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;ellipse;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="Stop both motors&#xa;Set exit flag" vertex="1">
          <mxGeometry height="100" width="300" x="450" y="600" as="geometry" />
        </mxCell>
        <mxCell id="final" parent="1" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;spacing=12;rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" value="End" vertex="1">
          <mxGeometry height="65" width="180" x="510" y="780" as="geometry" />
        </mxCell>
        <mxCell id="begin" edge="1" parent="1" source="initial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;" target="command" value="Show help menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="commandloop" edge="1" parent="1" source="command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.2;entryY=0;" target="command" value="Wait and command handled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="360" />
              <mxPoint x="30" y="220" />
              <mxPoint x="160" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="entry" edge="1" parent="1" source="command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" target="numeric" value="v/V- Velocity prompt&#xa;p/P- Kp prompt">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="accepted" edge="1" parent="1" source="numeric" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" target="command" value="Valid Enter&#xa;Save velocity or Kp and display prompt">
          <mxGeometry relative="1" x="-0.0003" y="-55" as="geometry">
            <mxPoint x="-55" y="55" as="offset" />
            <Array as="points">
              <mxPoint x="600" y="405" />
