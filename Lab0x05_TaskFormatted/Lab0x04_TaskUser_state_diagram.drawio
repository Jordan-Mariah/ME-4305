          </mxGeometry>
        </mxCell>
        <mxCell id="editing" edge="1" parent="1" source="numeric" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.8;entryY=0;" target="numeric" value="Continue / correct entry">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="360" />
              <mxPoint x="1190" y="220" />
              <mxPoint x="1040" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="exitcommand" edge="1" parent="1" source="command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;fontFamily=Arial;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" target="exit" value="e / E">
          <mxGeometry relative="1" as="geometry">
